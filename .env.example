# compose.yml이 읽는 환경변수. 서버에서 .env로 복사해 실제 값을 채운다.
# .env는 절대 커밋하지 않는다. (.gitignore 확인)
#   cp .env.example .env && chmod 600 .env

# ── MySQL ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=gm
MYSQL_USER=gm
MYSQL_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────
# guest/guest 금지. guest는 localhost 외 접속이 막혀 있고 기본값이라 위험하다.
RABBITMQ_USERNAME=gm
RABBITMQ_PASSWORD=

# ── 인증 ──────────────────────────────────────────────────────────────
# HS256 기준 최소 32바이트. openssl rand -base64 48
JWT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 외부 API ──────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── 프론트 연동 ────────────────────────────────────────────────────────
# 콤마 구분. Vercel 프리뷰까지 쓰려면 패턴 허용이 필요하다(백엔드 설정 확인).
FRONTEND_ALLOWED_ORIGINS=https://gm-fe-five.vercel.app
INVITE_BASE_URL=https://gm-fe-five.vercel.app/invite
OAUTH_ONBOARDING_REDIRECT_URI=https://gm-fe-five.vercel.app/onboarding
OAUTH_HOME_REDIRECT_URI=https://gm-fe-five.vercel.app/home

# ── JVM ───────────────────────────────────────────────────────────────
# 2GB 서버 기준. 4GB 이상이면 -XX:+UseG1GC 로 바꾸는 편이 낫다.
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseSerialGC
